{
  "name": "correduria-publica-2-morelos",
  "main": "worker.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "correduria-contenido-db",
      "database_id": "888bc969-2975-4590-a7ff-5e0e19971218"
    }
  ]
}
